{
  "name": "github-html-preview",
  "type": "module",
  "version": "1.0.0",
  "private": true,
  "description": "Chrome extension that adds a one-click Preview for .html files on GitHub.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/eeselapp/github-html-preview.git"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "vite build && vitest run --config vitest.e2e.config.ts"
  },
  "devDependencies": {
    "@crxjs/vite-plugin": "^2.4.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/chrome": "^0.1.37",
    "@types/node": "^25.5.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "jsdom": "^20.0.3",
    "playwright": "^1.58.2",
    "tailwindcss": "^4.3.3",
    "typescript": "~5.9.3",
    "vite": "^8.0.0",
    "vite-plugin-zip-pack": "^1.2.4",
    "vitest": "^4.1.9",
    "vitest-environment-web-ext": "^0.0.3"
  },
  "dependencies": {
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  }
}
